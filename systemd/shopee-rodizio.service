# Unidade systemd do shopee-rodizio. Instalação: ver README.md, seção "Deploy no BTT Pi".
#
# `User`/`Group` e os caminhos abaixo assumem o usuário `biqu` (padrão de fábrica da
# imagem BTT Pi/CB1) e o projeto clonado em `/home/biqu/shopee-rodizio` — ajuste às três
# linhas marcadas se o seu SBC usa outro usuário/caminho.

[Unit]
Description=shopee-rodizio - rodizio automatico de impulsionamento de anuncios Shopee
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=biqu
Group=biqu
WorkingDirectory=/home/biqu/shopee-rodizio
ExecStart=/home/biqu/.local/bin/uv run python -m shopee_rodizio /home/biqu/shopee-rodizio/config.toml
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
