# Unidade systemd do shopee-rodizio. Instalação: ver README.md, seção "Deploy no BTT Pi".
#
# `User`/`Group` e os caminhos abaixo assumem o usuário `biqu` (padrão de fábrica da
# imagem BTT Pi/CB1) e o projeto clonado em `/home/biqu/shopee-rodizio` — ajuste as linhas
# com esse caminho se o seu SBC usa outro usuário/caminho.
#
# Dependência do túnel: todas as chamadas à Shopee (inclusive a renovação do token) saem
# pelo SOCKS 127.0.0.1:1080 do shopee-proxy-tunnel.service (`[rede].proxy_https`). Sem
# túnel, sem rodízio. Antes isso vivia num drop-in em
# /etc/systemd/system/shopee-rodizio.service.d/tunel.conf — com estas linhas aqui, o
# drop-in pode ser removido (README, "Deploy no BTT Pi").

[Unit]
Description=shopee-rodizio - rodizio automatico de impulsionamento de anuncios Shopee
After=network-online.target shopee-proxy-tunnel.service
Wants=network-online.target
Requires=shopee-proxy-tunnel.service

[Service]
Type=simple
User=biqu
Group=biqu
WorkingDirectory=/home/biqu/shopee-rodizio
# o túnel é Type=simple: o systemd o dá como "ativo" assim que o ssh faz fork, antes de a
# porta SOCKS estar escutando — After= sozinho não fecha essa corrida
ExecStartPre=/bin/bash /home/biqu/shopee-rodizio/scripts/esperar_porta.sh 127.0.0.1 1080 30
ExecStart=/home/biqu/.local/bin/uv run python -m shopee_rodizio /home/biqu/shopee-rodizio/config.toml
Restart=on-failure
RestartSec=10
# 143 = 128 + SIGTERM: é como todo stop/restart termina — não é falha
SuccessExitStatus=143
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
