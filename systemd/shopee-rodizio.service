# Unidade systemd do shopee-rodizio. Instalação: ver README.md, seção "Deploy no BTT Pi".
#
# `User`/`Group` e os caminhos abaixo assumem o usuário `pi` e o projeto clonado em
# `/home/pi/shopee-rodizio` — ajuste às três linhas marcadas se o seu SBC usa outro
# usuário/caminho (o mesmo usuário que já roda o Klipper costuma servir, mas não é
# obrigatório).

[Unit]
Description=shopee-rodizio - rodizio automatico de impulsionamento de anuncios Shopee
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/shopee-rodizio
ExecStart=/home/pi/.local/bin/uv run python -m shopee_rodizio /home/pi/shopee-rodizio/config.toml
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
